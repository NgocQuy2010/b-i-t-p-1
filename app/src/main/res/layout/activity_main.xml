<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Hàng 1: ô 1 và 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#2F80ED"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FF3B3B"
            android:gravity="center"
            android:text="2"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Khoảng cách -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Hàng 2: ô 3, 4 và 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="102dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFD21C"
            android:gravity="center"
            android:text="3"
            android:textColor="#000000"
            android:textSize="36sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#2DB36B"
            android:gravity="center"
            android:text="4"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#7B3FE4"
            android:gravity="center"
            android:text="5"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Khoảng cách -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Hàng 3: ô 6 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="#FF7515"
        android:gravity="center"
        android:text="6"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- Khoảng trống lớn -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Phần nhập thông tin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:orientation="vertical">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Nhap thong tin sinh vien"
            android:textColor="#444444"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Ô nhập họ tên -->
        <EditText
            android:id="@+id/edtUserName"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/edit_text_background"
            android:hint="Enter your name"
            android:inputType="text"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#333333"
            android:textColorHint="#555555"
            android:textSize="10sp" />

        <!-- Ô nhập MSSV -->
        <EditText
            android:id="@+id/edtStudentId"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/edit_text_background"
            android:hint="Enter your student ID"
            android:inputType="text"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#333333"
            android:textColorHint="#555555"
            android:textSize="10sp" />

        <!-- Nút Click me -->
        <Button
            android:id="@+id/btnClickMe"
            android:layout_width="64dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_click_background"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Click me"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>